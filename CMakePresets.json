{
  "version": 6,
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release (GCC/MinGW-w64 + Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "CMAKE_CXX_COMPILER": "g++" }
    },
    {
      "name": "msvc",
      "displayName": "Release (Visual Studio 2022 Build Tools)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-msvc"
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "msvc", "configurePreset": "msvc", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "msvc", "configurePreset": "msvc", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
