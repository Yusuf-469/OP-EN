{
  // Built-in VS Code / Antigravity tasks: no extension required.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start packaged Workbench",
      "detail": "Runs the same Launch.exe that a double-click runs (opens the browser UI).",
      "type": "process",
      "command": "${workspaceFolder}/Launch.exe",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "silent" },
      "problemMatcher": []
    },
    {
      "label": "Build and test from source (CMake preset)",
      "type": "shell",
      "command": "cmake --preset release && cmake --build --preset release && ctest --preset release",
      "group": "test",
      "problemMatcher": ["$gcc"]
    }
  ]
}
